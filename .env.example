# Copie este arquivo para .env.local e preencha localmente.
# Nunca commitar valores reais.

# Supabase — quando ativarmos banco/auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_TEMP_PASSWORD=
ADMIN_SESSION_SECRET=

# Asaas — quando ativarmos checkout/webhooks
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_ENV=sandbox

# SendPulse — quando ativarmos captura/newsletter
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_ADDRESS_BOOK_ID=

# Newsletter self-hosted — candidato para Listmonk + Amazon SES
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=

# Anti-spam no formulário público — Cloudflare Turnstile ou alternativa similar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
