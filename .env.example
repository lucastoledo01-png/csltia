# Copie este arquivo para .env.local e preencha localmente.
# Nunca commitar valores reais.
#
# As variáveis marcadas como OBRIGATÓRIA não têm valor padrão: se faltarem, a
# funcionalidade correspondente falha de forma explícita em vez de assumir um
# valor embutido no código.

# Supabase — OBRIGATÓRIAS para qualquer rota que toque o banco
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Uma das duas abaixo é OBRIGATÓRIA (chave de serviço, somente no servidor)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Acesso ao painel administrativo
# ADMIN_PASSWORD é OBRIGATÓRIA (ADMIN_TEMP_PASSWORD é aceita como alternativa)
ADMIN_PASSWORD=
ADMIN_TEMP_PASSWORD=
# OBRIGATÓRIA — assina o cookie de sessão. Use valor aleatório longo e exclusivo.
ADMIN_SESSION_SECRET=

# OpenAI — OBRIGATÓRIA para o pipeline editorial
# Sem ela a redação falha; não existe modo de contingência gerando conteúdo.
OPENAI_API_KEY=
OPENAI_MODEL_TRIAGE=gpt-4o-mini
OPENAI_MODEL_EDITOR=gpt-4o

# Redação Automatizada & Automação Diária
DRY_RUN=false
NEWSLETTER_AUTO_SEND=true
# OBRIGATÓRIA para /api/cron/newsroom. Enviar como cabeçalho:
#   Authorization: Bearer <valor>
# O segredo não é mais aceito na query string.
CRON_SECRET=

# Instagram / Meta Graph API
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Listmonk Newsletter
LISTMONK_URL=
LISTMONK_FORM_LIST_UUID=7c3535ab-988f-4c98-88c0-b73be3b9a90b
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_DEFAULT_LIST_ID=

# Anti-spam no formulário público — Cloudflare Turnstile ou alternativa similar
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=casaloti.ia.br,www.casaloti.ia.br
