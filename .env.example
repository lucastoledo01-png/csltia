# Copie este arquivo para .env.local e preencha localmente.
# Nunca commitar valores reais.

# Supabase — quando ativarmos banco/auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — quando ativarmos checkout/webhooks
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_ENV=sandbox

# SendPulse — quando ativarmos captura/newsletter
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_ADDRESS_BOOK_ID=
