# ZernFlow Environment Configuration
# Copy to /opt/zernflow/.env and fill in the values

# Supabase (project: zernflow, org: casalotia)
NEXT_PUBLIC_SUPABASE_URL=https://ovxutsszpqbjpzbgjdaj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# App URL
NEXT_PUBLIC_APP_URL=https://zernflow.casaloti.ia.br

# Cron secret for /api/cron/jobs and /api/cron/sequences (both run every minute)
CRON_SECRET=CHANGE_ME_RANDOM_SECRET

# Optional: AI Gateway key fallback for the AI Response node (self-hosted).
# Provider keys (OpenAI/Anthropic/Google) are otherwise entered per-workspace in Settings.
# AI_GATEWAY_API_KEY=
