# ChatbotX Environment Configuration
# Copy to /opt/chatbotx/.env and update all CHANGE_ME values

# Database Configuration
POSTGRES_DB=chatbotx
POSTGRES_USER=chatbotx
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_REQUIRED
DATABASE_URL=postgresql://chatbotx:CHANGE_ME_STRONG_PASSWORD_REQUIRED@postgres:5432/chatbotx

# Redis Configuration
REDIS_URL=redis://redis:6379

# NextAuth Configuration (generate NEXTAUTH_SECRET with: openssl rand -base64 32)
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_URL=https://chatbotx.casaloti.ia.br

# Instagram Integration (from Meta Business Platform)
INSTAGRAM_BUSINESS_ACCOUNT_ID=CHANGE_ME_YOUR_ACCOUNT_ID
INSTAGRAM_ACCESS_TOKEN=CHANGE_ME_YOUR_META_ACCESS_TOKEN
INSTAGRAM_APP_ID=CHANGE_ME_YOUR_META_APP_ID
INSTAGRAM_APP_SECRET=CHANGE_ME_YOUR_META_APP_SECRET

# OpenAI Integration (optional, for AI features)
OPENAI_API_KEY=

# File Storage (RustFS)
RUSTFS_ACCESS_KEY=chatbotx
RUSTFS_SECRET_KEY=secretkey
RUSTFS_API_CORS_ALLOW_ORIGIN=*

# JavaScript Executor (min 32 characters for production)
JAVASCRIPT_EXECUTOR_TOKEN=CHANGE_ME_MIN_32_RANDOM_CHARACTERS_SECURE_TOKEN
MAX_CONCURRENCY=2

# Admin Credentials
ADMIN_EMAIL=admin@desbuguei.com.br
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
