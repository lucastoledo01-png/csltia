# OpenReply Environment Configuration
# Copy to /opt/openreply/.env and fill in the values

# App
NEXTAUTH_URL=https://openreply.casaloti.ia.br
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Database / queue (matches docker-compose.openreply.yml service names)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://openreply:CHANGE_ME_STRONG_PASSWORD@postgres:5432/openreply
REDIS_URL=redis://redis:6379

# Email magic links — using existing SMTP instead of Resend.
# URL-encode special characters in user/password (@ becomes %40).
# Port 465 = smtps:// (implicit TLS), port 587 = smtp:// (STARTTLS).
EMAIL_SERVER=smtps://USER%40DOMAIN.COM:PASSWORD@smtp.hostinger.com:465
EMAIL_FROM=OpenReply <login@casaloti.ia.br>

# Meta / Instagram (from the existing Meta App)
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=CHANGE_ME
INSTAGRAM_APP_SECRET=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
WEBHOOK_VERIFY_TOKEN=CHANGE_ME_openssl_rand_hex_16
