# Worker de renderização e publicação do Instagram.
#
# Precisa de Chromium, o que a hospedagem compartilhada não permitia. O
# navegador é instalado na versão exata do playwright declarado no
# package-lock, evitando divergência entre a biblioteca e o binário.

# A fala de vídeo sem legenda pronta (X, Instagram, site), transcrita no
# próprio worker (10/11/2026, decisão do dono): whisper.cpp compilado com
# versão fixada, sem OpenMP para não depender de biblioteca no runtime, e o
# modelo base multilíngue (148 MB), que detecta inglês e português.
FROM node:22-bookworm-slim AS whisper
ARG WHISPER_CPP_VERSION=v1.7.5
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${WHISPER_CPP_VERSION}" https://github.com/ggml-org/whisper.cpp /src/whisper \
  && cmake -S /src/whisper -B /src/whisper/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
       -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DWHISPER_BUILD_TESTS=OFF \
  && cmake --build /src/whisper/build --config Release -j 2 --target whisper-cli \
  && mkdir -p /opt/whisper \
  && curl -fsSL -o /opt/whisper/ggml-base.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.bin

FROM node:22-bookworm-slim

WORKDIR /app

COPY --from=whisper /src/whisper/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper /opt/whisper /opt/whisper
ENV WHISPER_MODELO=/opt/whisper/ggml-base.bin

# devDependencies são necessárias: o worker roda via tsx e o pacote playwright
# fornece o instalador do navegador.
COPY package.json package-lock.json ./
RUN npm ci

# --with-deps traz as bibliotecas de sistema que o Chromium exige.
RUN npx playwright install --with-deps chromium \
  && rm -rf /var/lib/apt/lists/*

# Reels (28/10/2026): o ffmpeg corta e compõe o vídeo no molde, e o yt-dlp
# baixa o vídeo do YouTube. O yt-dlp é um binário com versão fixada: o YouTube
# muda e a versão precisa subir junto, então ela é um ARG, não a "latest".
ARG YTDLP_VERSION=2026.10.26
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
  && curl -fsSL -o /usr/local/bin/yt-dlp \
       "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
  && chmod +x /usr/local/bin/yt-dlp \
  && rm -rf /var/lib/apt/lists/*

COPY tsconfig.json ./
COPY src ./src
# A montagem do Reel de vídeo lê a marca de public/marca (10/11/2026: sem esta
# linha os dois primeiros Reels do MCP falharam com o arquivo ausente).
COPY public ./public

ENV NODE_ENV=production
# Sem intervalo o script faz uma passada e encerra; com intervalo ele repete.
ENV WORKER_INTERVAL_SECONDS=900

CMD ["npx", "tsx", "src/scripts/instagram-worker.ts"]
